# === SMART RETAIL BILLING SYSTEM ===
# Environment Variables Example File

# The port node.js will run on (Default: 5001)
PORT=5001

# The secret key used for signing JSON Web Tokens (`jsonwebtoken`)
# Change this to a secure random string in production!
JWT_SECRET=my_super_secure_development_secret_123

# The explicitly declared path to Python 3 for spawning child processes (ML Scripts)
# Depending on your OS, it is usually "python" or "python3"
PYTHON_PATH=python
